<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.jayho.quant.sectorflow</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/jayho/AI/stock/.venv/bin/python</string>
    <string>/Users/jayho/AI/stock/scripts/run_sector_flow_snapshot.py</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/jayho/AI/stock</string>
