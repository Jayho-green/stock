    <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>14</integer><key>Minute</key><integer>56</integer></dict>
    <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>14</integer><key>Minute</key><integer>56</integer></dict>
    <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>14</integer><key>Minute</key><integer>56</integer></dict>
  </array>
  <key>StandardOutPath</key>
  <string>/Users/jayho/AI/stock/data/sector_flow.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/jayho/AI/stock/data/sector_flow.log</string>
</dict>
</plist>
